POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
ORGANIZATION_DB=organization_db
ORDERING_DB=ordering_db
INVENTORY_DB=inventory_db

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,PLAINTEXT_HOST://0.0.0.0:29092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

COLLECTOR_OTLP_ENABLED=true
OTEL_OTLP_ENDPOINT=http://jaeger:4317

JWT_AUDIENCE=wms
ORGANIZATION_JWT_ISSUER=http://organization:8080
ORGANIZATION_JWT_REFRESH_TOKEN_EXPIRES_IN_DAY=7
ORGANIZATION_JWT_ACCESS_TOKEN_EXPIRES_IN_MINUETS=30
JWT_AUTHORITY=http://organization:8080
ADMIN_PASSWORD=1qazXSW@
RSA_PEM_PATH=/app/keys/org-private.pem

ORGANIZATION_CONNECTION_STRING=Host=postgres;Port=5432;Username=postgres;Password=password;Database=organization_db
ORDERING_CONNECTION_STRING=Host=postgres;Port=5432;Username=postgres;Password=password;Database=ordering_db
INVENTORY_CONNECTION_STRING=Host=postgres;Port=5432;Username=postgres;Password=password;Database=inventory_db
ORGANIZATION_MIGRATION_DATABASE_URL=postgres://postgres:password@postgres:5432/organization_db?sslmode=disable
ORDERING_MIGRATION_DATABASE_URL=postgres://postgres:password@postgres:5432/ordering_db?sslmode=disable
INVENTORY_MIGRATION_DATABASE_URL=postgres://postgres:password@postgres:5432/inventory_db?sslmode=disable

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ORDERING_TOPIC=ordering.events
KAFKA_INVENTORY_TOPIC=inventory.events
KAFKA_ORDERING_DEAD_LETTER_TOPIC=ordering.events.dlq
KAFKA_INVENTORY_DEAD_LETTER_TOPIC=inventory.events.dlq

REDIS_CONNECTION_STRING=redis:6379
