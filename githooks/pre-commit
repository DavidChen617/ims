#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$' | sed -n 's#^src/Microservices/##p')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

INCLUDE_ARGS=""
for FILE in $STAGED_FILES; do
  INCLUDE_ARGS="$INCLUDE_ARGS --include $FILE"
done

(cd src/Microservices && dotnet format Microservices.slnx $INCLUDE_ARGS)

for FILE in $STAGED_FILES; do
  git add "src/Microservices/$FILE"
done

echo "Format check passed."